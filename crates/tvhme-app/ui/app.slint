import { ComboBox, ListView, Palette, CheckBox, ScrollView } from "std-widgets.slint";

export struct InfoRow { title: string, detail: string }
export struct ChannelItem { uuid: string, number: int, name: string, now: string }
export struct NavItem { id: int, label: string }
export struct TagItem { uuid: string, name: string, selected: bool }
export struct EventItem { id: int, channel: string, title: string, when: string, summary: string, state: string, dvr-uuid: string }
export struct RecItem { uuid: string, title: string, channel: string, when: string, status: string, running: bool }

export global Theme {
    in property <bool> use-system: false;
    in property <bool> dark: true;
    in property <color> accent: #c6a0f6;
    in property <color> c-text: #cad3f5;
    in property <color> c-subtext: #a5adcb;
    in property <color> c-base: #24273a;
    in property <color> c-mantle: #1e2030;
    in property <color> c-surface0: #363a4f;
    in property <color> c-surface1: #494d64;
    in property <color> c-ok: #a6da95;
    in property <color> c-warn: #eed49f;
    in property <color> c-bad: #ed8796;
    out property <color> bg: use-system ? Palette.background : c-base;
    out property <color> bar: use-system ? Palette.alternate-background : c-mantle;
    out property <color> card: use-system ? Palette.control-background : c-surface0;
    out property <color> card-hi: use-system ? Palette.selection-background : c-surface1;
    out property <color> fg: use-system ? Palette.foreground : c-text;
    out property <color> fg-dim: use-system ? Palette.foreground.with-alpha(0.65) : c-subtext;
    out property <color> acc: use-system ? Palette.accent-background : accent;
    out property <color> on-acc: use-system ? Palette.accent-foreground : c-base;
}


component TButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 40px; min-width: 72px; border-radius: 8px;
    background: !enabled ? Theme.card : (primary ? (ta.has-hover ? Theme.acc.brighter(0.15) : Theme.acc) : (ta.has-hover ? Theme.card-hi : Theme.card));
    Text { text: root.text; color: root.primary && root.enabled ? Theme.on-acc : Theme.fg; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    border-width: fs.has-focus ? 2px : 0px; border-color: Theme.acc;
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
}

component TField inherits Rectangle {
    in property <string> placeholder;
    in property <InputType> kind: InputType.text;
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited();
    min-height: 40px; border-radius: 8px; background: Theme.card;
    border-width: 2px; border-color: input.has-focus ? Theme.acc : transparent;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Rectangle {
            Text { visible: input.text == ""; text: root.placeholder; color: Theme.fg-dim; vertical-alignment: center; overflow: elide; width: parent.width; }
            // Identifiers, URLs and passwords: no auto-capital, no auto-correct/suggestions
            input := TextInput {
                color: Theme.fg; input-type: root.kind; vertical-alignment: center; single-line: true;
                selection-background-color: Theme.acc.with-alpha(0.4); selection-foreground-color: Theme.fg;
                input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
            TouchArea { clicked => { input.focus(); } }
        }
    }
}

component InfoSection inherits VerticalLayout {
    in property <string> heading;
    in property <[InfoRow]> rows;
    in property <string> empty-text: "Nothing right now";
    spacing: 6px;
    Text { text: root.heading; color: Theme.acc; font-weight: 700; font-size: 14px; }
    if root.rows.length == 0: Text { text: root.empty-text; color: Theme.fg-dim; font-size: 13px; }
    for r in root.rows: Rectangle {
        background: Theme.card; border-radius: 8px;
        VerticalLayout {
            padding: 10px; spacing: 2px;
            Text { text: r.title; color: Theme.fg; font-weight: 600; overflow: elide; }
            Text { text: r.detail; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
        }
    }
}

component SignalMeter inherits Rectangle {
    in property <string> label;
    in property <float> value; // 0..100, negative = no bar
    in property <string> text;
    height: 22px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; color: Theme.fg-dim; width: 34px; vertical-alignment: center; font-size: 12px; }
        Rectangle {
            background: Theme.card; border-radius: 4px;
            Rectangle {
                visible: root.value >= 0;
                x: 0; width: parent.width * clamp(root.value / 100, 0, 1); height: parent.height; border-radius: 4px;
                background: root.value >= 60 ? #a6da95 : (root.value >= 30 ? #eed49f : #ed8796);
            }
        }
        Text { text: root.text; color: Theme.fg; width: 64px; vertical-alignment: center; font-size: 12px; horizontal-alignment: right; }
    }
}


component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 34px; border-radius: 17px;
    width: label.preferred-width + 28px;
    background: root.active ? Theme.acc : (ta.has-hover ? Theme.card-hi : Theme.card);
    label := Text { x: 14px; text: root.text; color: root.active ? Theme.on-acc : Theme.fg; vertical-alignment: center; font-size: 13px; font-weight: 600; height: parent.height; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> vertical;
    callback clicked();
    min-height: 44px; border-radius: 10px;
    background: root.active ? Theme.acc.with-alpha(0.22) : (ta.has-hover ? Theme.card : transparent);
    Text {
        text: root.text; color: root.active ? Theme.acc : Theme.fg; font-weight: 700; font-size: 14px;
        horizontal-alignment: root.vertical ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
        vertical-alignment: center; x: root.vertical ? 16px : 0px; width: parent.width - (root.vertical ? 16px : 0px);
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component EventRow inherits Rectangle {
    in property <EventItem> ev;
    callback record();
    callback cancel();
    height: 92px;
    Rectangle {
        y: 4px; height: parent.height - 8px; background: Theme.card; border-radius: 8px;
        HorizontalLayout {
            padding: 10px; spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 2px; alignment: center;
                Text { text: root.ev.channel != "" ? root.ev.when + "  ·  " + root.ev.channel : root.ev.when; color: Theme.fg-dim; font-size: 12px; overflow: elide; }
                Text { text: root.ev.title; color: Theme.fg; font-weight: 700; overflow: elide; }
                Text { text: root.ev.summary; color: Theme.fg-dim; font-size: 12px; overflow: elide; }
            }
            VerticalLayout {
                alignment: center; spacing: 4px; width: 92px;
                if root.ev.state != "": Text { text: "● " + root.ev.state; color: Theme.c-bad; font-size: 12px; horizontal-alignment: right; }
                TButton {
                    text: root.ev.dvr-uuid != "" ? "Cancel" : "Record"; height: 34px;
                    clicked => { if root.ev.dvr-uuid != "" { root.cancel(); } else { root.record(); } }
                }
            }
        }
    }
}

component RecRow inherits Rectangle {
    in property <RecItem> rec;
    in property <int> kind; // 0 upcoming, 1 finished, 2 failed
    callback stop();
    callback cancel();
    callback remove();
    callback play();
    height: 84px;
    Rectangle {
        y: 4px; height: parent.height - 8px; background: Theme.card; border-radius: 8px;
        HorizontalLayout {
            padding: 10px; spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 2px; alignment: center;
                Text { text: root.rec.title; color: Theme.fg; font-weight: 700; overflow: elide; }
                Text { text: root.rec.channel + "  ·  " + root.rec.when; color: Theme.fg-dim; font-size: 12px; overflow: elide; }
                Text { text: root.rec.status; color: root.rec.running ? Theme.c-bad : Theme.fg-dim; font-size: 12px; overflow: elide; }
            }
            VerticalLayout {
                alignment: center; spacing: 4px; width: 92px;
                if root.kind == 1 || root.rec.running: TButton { text: "▶ Play"; primary: true; height: 34px; clicked => { root.play(); } }
                if root.rec.running: TButton { text: "Stop"; height: 34px; clicked => { root.stop(); } }
                if !root.rec.running && root.kind == 0: TButton { text: "Cancel"; height: 34px; clicked => { root.cancel(); } }
                if !root.rec.running && root.kind != 0: TButton { text: "Delete"; height: 34px; clicked => { root.remove(); } }
            }
        }
    }
}

component TSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);
    min-height: 40px; border-radius: 8px; background: Theme.card;
    border-width: fs.has-focus ? 2px : 0px; border-color: Theme.acc;
    Text { x: 12px; width: parent.width - 40px; text: root.model[root.current-index]; color: Theme.fg; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 28px; text: "▾"; color: Theme.fg-dim; vertical-alignment: center; }
    ta := TouchArea { clicked => { pop.show(); } }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") { pop.show(); return accept; }
            if (e.text == Key.DownArrow && root.current-index < root.model.length - 1) { root.current-index += 1; root.selected(root.current-index); return accept; }
            if (e.text == Key.UpArrow && root.current-index > 0) { root.current-index -= 1; root.selected(root.current-index); return accept; }
            reject
        }
    }
    pop := PopupWindow {
        x: 0; y: root.height + 2px; width: root.width; height: min(root.model.length * 40px + 8px, 280px);
        close-policy: close-on-click-outside;
        Rectangle { background: Theme.bar; border-radius: 8px; border-width: 1px; border-color: Theme.card-hi; }
        Flickable {
            content-height: root.model.length * 40px + 8px;
            for item[i] in root.model: Rectangle {
                y: 4px + i * 40px; height: 40px; x: 4px; width: parent.width - 8px; border-radius: 6px;
                background: pa.has-hover ? Theme.card-hi : (i == root.current-index ? Theme.card : transparent);
                Text { x: 10px; text: item; color: i == root.current-index ? Theme.acc : Theme.fg; vertical-alignment: center; }
                pa := TouchArea { clicked => { root.current-index = i; root.selected(i); pop.close(); } }
            }
        }
    }
}

component AppearancePanel inherits VerticalLayout {
    in-out property <int> mode-index: 0;
    in-out property <int> flavor-index: 2;
    in-out property <int> accent-index: 3;
    callback apply(int, int, int);
    padding: 20px; spacing: 12px; alignment: start;
    Text { text: "Appearance"; color: Theme.fg; font-size: 22px; font-weight: 700; }
    Text { text: "Style"; color: Theme.fg-dim; }
    TSelect {
        model: ["Catppuccin", "AMOLED black", "System (native)"]; current-index <=> root.mode-index;
        selected(i) => { root.apply(root.flavor-index, root.accent-index, root.mode-index); }
    }
    Text { text: "Flavor"; color: Theme.fg-dim; }
    TSelect {
        model: ["Latte", "Frappé", "Macchiato", "Mocha"]; current-index <=> root.flavor-index;
        selected(i) => { root.apply(root.flavor-index, root.accent-index, root.mode-index); }
    }
    Text { text: "Accent"; color: Theme.fg-dim; }
    TSelect {
        model: ["Rosewater", "Flamingo", "Pink", "Mauve", "Red", "Maroon", "Peach", "Yellow", "Green", "Teal", "Sky", "Sapphire", "Blue", "Lavender"];
        current-index <=> root.accent-index;
        selected(i) => { root.apply(root.flavor-index, root.accent-index, root.mode-index); }
    }
}

component Header inherits Rectangle {
    in property <string> title;
    background: Theme.bar; height: 52px;
    Text { x: 16px; text: root.title; color: Theme.fg; font-size: 20px; font-weight: 700; vertical-alignment: center; height: parent.height; }
    @children
}

export component MainWindow inherits Window {
    title: "TVHme";
    min-width: 360px; min-height: 560px; preferred-width: 1000px; preferred-height: 680px;
    background: Theme.bg;
    property <bool> dark: Theme.dark;
    property <bool> sys: Theme.use-system;
    init => { root.sync-scheme(); }
    changed dark => { root.sync-scheme(); }
    changed sys => { root.sync-scheme(); }
    function sync-scheme() {
        Palette.color-scheme = root.sys ? ColorScheme.unknown : (root.dark ? ColorScheme.dark : ColorScheme.light);
    }
    property <bool> wide: root.width >= 720px;

    // 0 = connect, 1 = main shell, 2 = appearance (before connecting)
    in-out property <int> screen: 0;
    // shell tab ids: 0 Live, 1 Guide, 2 Recordings, 3 Search, 4 Server (admin), 5 Settings
    in-out property <int> tab: 0;
    in property <bool> busy: false;
    in property <string> error;
    in property <bool> is-admin: false;
    in property <[NavItem]> nav;
    in-out property <string> toast;
    in property <[ChannelItem]> channels;
    in property <[TagItem]> tags;
    in property <[string]> channel-names;
    in-out property <int> guide-index: 0;
    in property <[EventItem]> guide-events;
    in property <bool> guide-busy: false;
    in-out property <string> search-text;
    in-out property <bool> search-full: true;
    in property <[EventItem]> search-events;
    in property <string> search-note;
    in-out property <int> rec-kind: 0;
    in property <[RecItem]> recordings;
    in property <string> rec-note;
    in property <string> now-playing;
    in property <string> play-note;
    in property <bool> has-signal: false;
    in property <float> snr: -1;
    in property <float> ss: -1;
    in property <string> snr-text;
    in property <string> ss-text;
    in property <string> server-info;
    in property <string> me-text;
    in property <string> server-error;
    in property <bool> server-busy: false;
    in property <[InfoRow]> tuners;
    in property <[InfoRow]> streams;
    in property <[InfoRow]> clients;
    in property <length> extra-top: 0px;
    in-out property <string> host;
    in-out property <string> htsp-port: "9982";
    in-out property <bool> insecure: false;
    in-out property <string> user;
    in-out property <string> password;
    in-out property <int> t-mode: 0;
    in-out property <int> t-flavor: 2;
    in-out property <int> t-accent: 3;
    in-out property <int> player: 0;
    in property <[string]> player-names;

    callback connect(string, string, string, string, bool);
    callback tab-changed(int);
    callback select-tag(string);
    callback play(string);
    callback record-now(string, string);
    callback stop-playback();
    callback load-guide(int);
    callback do-search(string, bool);
    callback record-event(int);
    callback cancel-recording(string);
    callback stop-recording(string);
    callback remove-recording(string);
    callback load-recordings(int);
    callback apply-theme(int, int, int);
    callback refresh-server();
    callback play-recording(string);
    callback sign-out();
    callback player-changed(int);

    Timer {
        interval: 4s; running: root.toast != "";
        triggered => { root.toast = ""; }
    }

    Rectangle {
        x: root.safe-area-insets.left; y: max(root.safe-area-insets.top, root.extra-top);
        width: parent.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: parent.height - max(root.safe-area-insets.top, root.extra-top) - root.safe-area-insets.bottom;

        if root.screen == 0: Flickable {
            content-height: max(self.height, form.preferred-height);
            form := VerticalLayout {
                alignment: center; padding: 24px; spacing: 10px;
                Text { text: "TVHme"; color: Theme.acc; font-size: 36px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "Connect to Tvheadend"; color: Theme.fg-dim; horizontal-alignment: center; }
                TField { placeholder: "Server address"; text <=> root.host; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure); } }
                Text { text: "e.g. 10.0.0.5:9981 or https://tv.example.com"; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "HTSP port (signal)"; color: Theme.fg-dim; vertical-alignment: center; }
                    TField { placeholder: "9982"; text <=> root.htsp-port; kind: InputType.number; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure); } }
                }
                TField { placeholder: "Username"; text <=> root.user; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure); } }
                TField { placeholder: "Password"; kind: InputType.password; text <=> root.password; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure); } }
                CheckBox { text: "Allow self-signed certificate"; checked <=> root.insecure; }
                TButton {
                    text: root.busy ? "Connecting…" : "Connect"; primary: true; enabled: !root.busy;
                    clicked => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure); }
                }
                if root.error != "": Text { text: root.error; color: Theme.c-bad; wrap: word-wrap; horizontal-alignment: center; }
                TButton { text: "Appearance"; clicked => { root.screen = 2; } }
            }
        }

        if root.screen == 2: VerticalLayout {
            alignment: start;
            AppearancePanel {
                mode-index <=> root.t-mode; flavor-index <=> root.t-flavor; accent-index <=> root.t-accent;
                apply(f, a, m) => { root.apply-theme(f, a, m); }
            }
            HorizontalLayout { padding: 20px; padding-top: 4px; alignment: start; TButton { text: "Back"; primary: true; width: 120px; height: 44px; clicked => { root.screen = 0; } } }
        }

        if root.screen == 1: Rectangle {
            // navigation: rail on wide windows, bar at the bottom on narrow ones
            Rectangle {
                x: 0; y: root.wide ? 0px : parent.height - 60px;
                width: root.wide ? 200px : parent.width; height: root.wide ? parent.height : 60px;
                background: Theme.bar;
                if root.wide: VerticalLayout {
                    padding: 12px; spacing: 6px; alignment: start;
                    Text { text: "TVHme"; color: Theme.acc; font-size: 24px; font-weight: 800; }
                    Rectangle { height: 10px; }
                    for n in root.nav: NavButton {
                        text: n.label; vertical: true; active: root.tab == n.id;
                        clicked => { root.tab = n.id; root.tab-changed(n.id); }
                    }
                }
                if !root.wide: HorizontalLayout {
                    padding: 6px; spacing: 4px;
                    for n in root.nav: NavButton {
                        text: n.label; vertical: false; active: root.tab == n.id;
                        clicked => { root.tab = n.id; root.tab-changed(n.id); }
                    }
                }
            }
            Rectangle {
                x: root.wide ? 200px : 0px; y: 0;
                width: root.wide ? parent.width - 200px : parent.width;
                height: root.wide ? parent.height : parent.height - 60px;

                // ---- Live
                if root.tab == 0: VerticalLayout {
                    Header { title: "Live TV"; }
                    Flickable {
                        height: 50px; content-width: chips.preferred-width + 24px;
                        chips := HorizontalLayout {
                            x: 12px; y: 8px; spacing: 8px; height: 34px;
                            for t in root.tags: Chip { text: t.name; active: t.selected; clicked => { root.select-tag(t.uuid); } }
                        }
                    }
                    ListView {
                        for ch in root.channels: Rectangle {
                            height: 60px;
                            background: ta.has-hover ? Theme.card-hi : transparent;
                            ta := TouchArea { clicked => { root.play(ch.uuid); } }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 12px; spacing: 12px;
                                Text { text: ch.number; color: Theme.fg-dim; width: 36px; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text { text: ch.name; color: Theme.fg; overflow: elide; }
                                    if ch.now != "": Text { text: ch.now; color: Theme.fg-dim; font-size: 12px; overflow: elide; }
                                }
                                VerticalLayout { alignment: center; TButton { text: "● Rec"; width: 76px; height: 34px; clicked => { root.record-now(ch.uuid, ch.name); } } }
                            }
                        }
                    }
                    if root.now-playing != "": Rectangle {
                        background: Theme.bar; height: 128px;
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            HorizontalLayout {
                                Text { text: root.now-playing; color: Theme.fg; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                TButton { text: "Stop"; width: 72px; height: 40px; clicked => { root.stop-playback(); } }
                            }
                            if root.has-signal && root.snr-text != "": SignalMeter { label: "SNR"; value: root.snr; text: root.snr-text; }
                            if root.has-signal && root.ss-text != "": SignalMeter { label: "SS"; value: root.ss; text: root.ss-text; }
                            if root.play-note != "": Text { text: root.play-note; color: Theme.c-warn; font-size: 12px; }
                            if !root.has-signal && root.play-note == "": Text { text: "Waiting for signal info…"; color: Theme.fg-dim; font-size: 12px; }
                        }
                    }
                }

                // ---- Guide
                if root.tab == 1: VerticalLayout {
                    Header { title: "Guide"; }
                    VerticalLayout {
                        padding: 12px; spacing: 8px;
                        TSelect {
                            model: root.channel-names; current-index <=> root.guide-index;
                            selected(i) => { root.load-guide(i); }
                        }
                    }
                    if root.guide-events.length == 0: Text { text: root.guide-busy ? "Loading…" : "No guide data for this channel"; color: Theme.fg-dim; horizontal-alignment: center; }
                    ListView {
                        for ev in root.guide-events: EventRow {
                            ev: ev;
                            record => { root.record-event(ev.id); }
                            cancel => { root.cancel-recording(ev.dvr-uuid); }
                        }
                    }
                }

                // ---- Recordings
                if root.tab == 2: VerticalLayout {
                    Header { title: "Recordings"; }
                    HorizontalLayout {
                        padding: 12px; spacing: 8px; height: 58px;
                        Chip { text: "Upcoming"; active: root.rec-kind == 0; clicked => { root.rec-kind = 0; root.load-recordings(0); } }
                        Chip { text: "Finished"; active: root.rec-kind == 1; clicked => { root.rec-kind = 1; root.load-recordings(1); } }
                        Chip { text: "Failed"; active: root.rec-kind == 2; clicked => { root.rec-kind = 2; root.load-recordings(2); } }
                    }
                    if root.rec-note != "": Text { text: root.rec-note; color: Theme.fg-dim; horizontal-alignment: center; wrap: word-wrap; }
                    ListView {
                        for r in root.recordings: RecRow {
                            rec: r; kind: root.rec-kind;
                            play => { root.play-recording(r.uuid); }
                            stop => { root.stop-recording(r.uuid); }
                            cancel => { root.cancel-recording(r.uuid); }
                            remove => { root.remove-recording(r.uuid); }
                        }
                    }
                }

                // ---- Search
                if root.tab == 3: VerticalLayout {
                    Header { title: "Search the guide"; }
                    VerticalLayout {
                        padding: 12px; spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            TField { placeholder: "Title or text"; text <=> root.search-text; accepted => { root.do-search(root.search-text, root.search-full); } }
                            TButton { text: "Search"; primary: true; width: 90px; clicked => { root.do-search(root.search-text, root.search-full); } }
                        }
                        CheckBox { text: "Also search descriptions"; checked <=> root.search-full; }
                    }
                    if root.search-note != "": Text { text: root.search-note; color: Theme.fg-dim; horizontal-alignment: center; }
                    ListView {
                        for ev in root.search-events: EventRow {
                            ev: ev;
                            record => { root.record-event(ev.id); }
                            cancel => { root.cancel-recording(ev.dvr-uuid); }
                        }
                    }
                }

                // ---- Server (admin)
                if root.tab == 4: VerticalLayout {
                    Header {
                        title: "Server";
                        TButton { x: parent.width - 98px; y: 8px; text: root.server-busy ? "…" : "Refresh"; enabled: !root.server-busy; width: 90px; height: 36px; clicked => { root.refresh-server(); } }
                    }
                    ScrollView {
                        VerticalLayout {
                            padding: 16px; spacing: 16px; alignment: start;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: root.me-text; color: Theme.fg; font-weight: 700; wrap: word-wrap; }
                                Text { text: root.server-info; color: Theme.fg-dim; wrap: word-wrap; font-size: 13px; }
                                if root.server-error != "": Text { text: root.server-error; color: Theme.c-bad; wrap: word-wrap; }
                            }
                            InfoSection { heading: "Tuners"; rows: root.tuners; empty-text: "No tuner information"; }
                            InfoSection { heading: "Active streams"; rows: root.streams; empty-text: "No active streams"; }
                            InfoSection { heading: "Connected clients"; rows: root.clients; empty-text: "No connected clients"; }
                            Text { text: "More management (channels, networks, recorder settings, users) is planned. The server decides what each account may change."; color: Theme.fg-dim; wrap: word-wrap; font-size: 12px; }
                        }
                    }
                }

                // ---- Settings
                if root.tab == 5: VerticalLayout {
                    Header { title: "Settings"; }
                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            VerticalLayout {
                                padding: 20px; padding-bottom: 0px; spacing: 8px;
                                Text { text: root.me-text; color: Theme.fg-dim; wrap: word-wrap; }
                                Text { text: "Video player"; color: Theme.fg; font-size: 22px; font-weight: 700; }
                                TSelect { model: root.player-names; current-index <=> root.player; selected(i) => { root.player-changed(i); } }
                                TButton { text: "Sign out (forget password)"; clicked => { root.sign-out(); } }
                            }
                            AppearancePanel {
                                mode-index <=> root.t-mode; flavor-index <=> root.t-flavor; accent-index <=> root.t-accent;
                                apply(f, a, m) => { root.apply-theme(f, a, m); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2; y: parent.height - self.height - (root.wide ? 24px : 84px);
        width: min(parent.width - 32px, 560px); height: 44px;
        background: Theme.card-hi; border-radius: 10px; border-width: 1px; border-color: Theme.acc;
        Text { text: root.toast; color: Theme.fg; horizontal-alignment: center; vertical-alignment: center; overflow: elide; width: parent.width - 20px; x: 10px; }
    }
}

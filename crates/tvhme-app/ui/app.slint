import { ComboBox, ListView, Palette, CheckBox, ScrollView } from "std-widgets.slint";

export struct InfoRow { title: string, detail: string }
export struct ChannelItem { uuid: string, number: int, name: string, now: string }

export global Theme {
    in property <bool> use-system: false;
    in property <bool> dark: true;
    in property <color> accent: #c6a0f6;
    in property <color> c-text: #cad3f5;
    in property <color> c-subtext: #a5adcb;
    in property <color> c-base: #24273a;
    in property <color> c-mantle: #1e2030;
    in property <color> c-surface0: #363a4f;
    in property <color> c-surface1: #494d64;
    in property <color> c-ok: #a6da95;
    in property <color> c-warn: #eed49f;
    in property <color> c-bad: #ed8796;
    out property <color> bg: use-system ? Palette.background : c-base;
    out property <color> bar: use-system ? Palette.alternate-background : c-mantle;
    out property <color> card: use-system ? Palette.control-background : c-surface0;
    out property <color> card-hi: use-system ? Palette.selection-background : c-surface1;
    out property <color> fg: use-system ? Palette.foreground : c-text;
    out property <color> fg-dim: use-system ? Palette.foreground.with-alpha(0.65) : c-subtext;
    out property <color> acc: use-system ? Palette.accent-background : accent;
    out property <color> on-acc: use-system ? Palette.accent-foreground : c-base;
}


component TButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 40px; min-width: 72px; border-radius: 8px;
    background: !enabled ? Theme.card : (primary ? (ta.has-hover ? Theme.acc.brighter(0.15) : Theme.acc) : (ta.has-hover ? Theme.card-hi : Theme.card));
    Text { text: root.text; color: root.primary && root.enabled ? Theme.on-acc : Theme.fg; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component TField inherits Rectangle {
    in property <string> placeholder;
    in property <InputType> kind: InputType.text;
    in-out property <string> text <=> input.text;
    min-height: 40px; border-radius: 8px; background: Theme.card;
    border-width: 2px; border-color: input.has-focus ? Theme.acc : transparent;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Rectangle {
            Text { visible: input.text == ""; text: root.placeholder; color: Theme.fg-dim; vertical-alignment: center; }
            input := TextInput { color: Theme.fg; input-type: root.kind; vertical-alignment: center; single-line: true; }
        }
    }
}

component InfoSection inherits VerticalLayout {
    in property <string> heading;
    in property <[InfoRow]> rows;
    in property <string> empty-text: "Nothing right now";
    spacing: 6px;
    Text { text: root.heading; color: Theme.acc; font-weight: 700; font-size: 14px; }
    if root.rows.length == 0: Text { text: root.empty-text; color: Theme.fg-dim; font-size: 13px; }
    for r in root.rows: Rectangle {
        background: Theme.card; border-radius: 8px;
        VerticalLayout {
            padding: 10px; spacing: 2px;
            Text { text: r.title; color: Theme.fg; font-weight: 600; overflow: elide; }
            Text { text: r.detail; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
        }
    }
}

component SignalMeter inherits Rectangle {
    in property <string> label;
    in property <float> value; // 0..100, negative = no bar
    in property <string> text;
    height: 22px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; color: Theme.fg-dim; width: 34px; vertical-alignment: center; font-size: 12px; }
        Rectangle {
            background: Theme.card; border-radius: 4px;
            Rectangle {
                visible: root.value >= 0;
                x: 0; width: parent.width * clamp(root.value / 100, 0, 1); height: parent.height; border-radius: 4px;
                background: root.value >= 60 ? #a6da95 : (root.value >= 30 ? #eed49f : #ed8796);
            }
        }
        Text { text: root.text; color: Theme.fg; width: 64px; vertical-alignment: center; font-size: 12px; horizontal-alignment: right; }
    }
}

export component MainWindow inherits Window {
    title: "TVHme";
    min-width: 360px; min-height: 560px; preferred-width: 900px; preferred-height: 640px;
    background: Theme.bg;
    property <bool> dark: Theme.dark;
    property <bool> sys: Theme.use-system;
    init => { root.sync-scheme(); }
    changed dark => { root.sync-scheme(); }
    changed sys => { root.sync-scheme(); }
    function sync-scheme() {
        Palette.color-scheme = root.sys ? ColorScheme.unknown : (root.dark ? ColorScheme.dark : ColorScheme.light);
    }

    // 0 = connect, 1 = channels, 2 = settings, 3 = server (admin only)
    in-out property <int> screen: 0;
    in property <bool> busy: false;
    in property <string> error;
    in property <bool> is-admin: false;
    in property <[ChannelItem]> channels;
    in property <string> now-playing;
    in property <string> play-note;
    in property <bool> has-signal: false;
    in property <float> snr: -1;
    in property <float> ss: -1;
    in property <string> snr-text;
    in property <string> ss-text;
    in property <string> server-info;
    in property <string> me-text;
    in property <string> server-error;
    in property <bool> server-busy: false;
    in property <[InfoRow]> tuners;
    in property <[InfoRow]> streams;
    in property <[InfoRow]> clients;
    in property <length> extra-top: 0px;
    in-out property <string> host;
    in-out property <string> htsp-port: "9982";
    in-out property <bool> insecure: false;
    in-out property <string> user;
    in-out property <string> password;

    callback connect(string, string, string, string, bool);
    callback play(string);
    callback stop-playback();
    callback apply-theme(int, int, int);
    callback refresh-server();

    VerticalLayout {
        padding-top: max(root.safe-area-insets.top, root.extra-top);
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        if root.screen == 0: Rectangle {
            VerticalLayout {
                alignment: center; padding: 24px; spacing: 10px;
                Text { text: "TVHme"; color: Theme.acc; font-size: 36px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "Connect to Tvheadend"; color: Theme.fg-dim; horizontal-alignment: center; }
                host-edit := TField { placeholder: "Server, e.g. 10.0.0.5:9981 or https://tv.example.com"; text <=> root.host; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "HTSP port (signal)"; color: Theme.fg-dim; vertical-alignment: center; }
                    TField { placeholder: "9982"; text <=> root.htsp-port; kind: InputType.number; }
                }
                user-edit := TField { placeholder: "Username"; text <=> root.user; }
                pass-edit := TField { placeholder: "Password"; kind: InputType.password; text <=> root.password; }
                CheckBox { text: "Allow self-signed certificate"; checked <=> root.insecure; }
                TButton {
                    text: root.busy ? "Connecting…" : "Connect"; primary: true; enabled: !root.busy;
                    clicked => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure); }
                }
                if root.error != "": Text { text: root.error; color: Theme.c-bad; wrap: word-wrap; horizontal-alignment: center; }
                TButton { text: "Appearance"; clicked => { root.screen = 2; } }
            }
        }
        if root.screen == 1: VerticalLayout {
            Rectangle {
                background: Theme.bar; height: 52px;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 8px; spacing: 8px;
                    Text { text: "Channels"; color: Theme.fg; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.is-admin: VerticalLayout { alignment: center; TButton { text: "Server"; width: 84px; height: 36px; clicked => { root.screen = 3; root.refresh-server(); } } }
                    VerticalLayout { alignment: center; TButton { text: "Appearance"; width: 110px; height: 36px; clicked => { root.screen = 2; } } }
                }
            }
            ListView {
                for ch in root.channels: Rectangle {
                    height: 56px;
                    background: ta.has-hover ? Theme.card-hi : transparent;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; spacing: 12px;
                        Text { text: ch.number; color: Theme.fg-dim; width: 36px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Text { text: ch.name; color: Theme.fg; overflow: elide; }
                            if ch.now != "": Text { text: ch.now; color: Theme.fg-dim; font-size: 12px; overflow: elide; }
                        }
                    }
                    ta := TouchArea { clicked => { root.play(ch.uuid); } }
                }
            }
            if root.now-playing != "": Rectangle {
                background: Theme.bar; height: 128px;
                VerticalLayout {
                    padding: 12px; spacing: 6px;
                    HorizontalLayout {
                        Text { text: root.now-playing; color: Theme.fg; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        TButton { text: "Stop"; clicked => { root.stop-playback(); } }
                    }
                    if root.has-signal && root.snr-text != "": SignalMeter { label: "SNR"; value: root.snr; text: root.snr-text; }
                    if root.has-signal && root.ss-text != "": SignalMeter { label: "SS"; value: root.ss; text: root.ss-text; }
                    if root.play-note != "": Text { text: root.play-note; color: Theme.c-warn; font-size: 12px; }
                    if !root.has-signal && root.play-note == "": Text { text: "Waiting for signal info…"; color: Theme.fg-dim; font-size: 12px; }
                }
            }
        }
        if root.screen == 2: VerticalLayout {
            padding: 20px; spacing: 12px; alignment: start;
            Text { text: "Appearance"; color: Theme.fg; font-size: 22px; font-weight: 700; }
            Text { text: "Style"; color: Theme.fg-dim; }
            mode := ComboBox {
                model: ["Catppuccin", "AMOLED black", "System (native)"]; current-index: 0;
                selected => { root.apply-theme(flavor.current-index, accent.current-index, mode.current-index); }
            }
            Text { text: "Flavor"; color: Theme.fg-dim; }
            flavor := ComboBox {
                model: ["Latte", "Frappé", "Macchiato", "Mocha"]; current-index: 2;
                selected => { root.apply-theme(flavor.current-index, accent.current-index, mode.current-index); }
            }
            Text { text: "Accent"; color: Theme.fg-dim; }
            accent := ComboBox {
                model: ["Rosewater", "Flamingo", "Pink", "Mauve", "Red", "Maroon", "Peach", "Yellow", "Green", "Teal", "Sky", "Sapphire", "Blue", "Lavender"];
                current-index: 3;
                selected => { root.apply-theme(flavor.current-index, accent.current-index, mode.current-index); }
            }
            TButton { text: "Back"; primary: true; clicked => { root.screen = root.channels.length > 0 ? 1 : 0; } }
        }
        if root.screen == 3: VerticalLayout {
            Rectangle {
                background: Theme.bar; height: 52px;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 8px; spacing: 8px;
                    Text { text: "Server"; color: Theme.fg; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; TButton { text: root.server-busy ? "…" : "Refresh"; enabled: !root.server-busy; width: 90px; height: 36px; clicked => { root.refresh-server(); } } }
                    VerticalLayout { alignment: center; TButton { text: "Back"; width: 72px; height: 36px; clicked => { root.screen = 1; } } }
                }
            }
            ScrollView {
                VerticalLayout {
                    padding: 16px; spacing: 16px; alignment: start;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: root.me-text; color: Theme.fg; font-weight: 700; wrap: word-wrap; }
                        Text { text: root.server-info; color: Theme.fg-dim; wrap: word-wrap; font-size: 13px; }
                        if root.server-error != "": Text { text: root.server-error; color: Theme.c-bad; wrap: word-wrap; }
                    }
                    InfoSection { heading: "Tuners"; rows: root.tuners; empty-text: "No tuner information"; }
                    InfoSection { heading: "Active streams"; rows: root.streams; empty-text: "No active streams"; }
                    InfoSection { heading: "Connected clients"; rows: root.clients; empty-text: "No connected clients"; }
                    Text { text: "More management (channels, networks, recorder settings, users) is planned. The server decides what each account may change."; color: Theme.fg-dim; wrap: word-wrap; font-size: 12px; }
                }
            }
        }
    }
}

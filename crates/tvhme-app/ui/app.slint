import { ComboBox, ListView, Palette, CheckBox, ScrollView } from "std-widgets.slint";

export struct InfoRow { title: string, detail: string }
export struct ChannelItem { uuid: string, number: int, name: string, logo: image, has-logo: bool, initials: string, now-title: string, now-progress: float, next-title: string, next-time: string, now-id: int, next-id: int }
export struct NavItem { id: int, label: string }
export struct TagItem { uuid: string, name: string, selected: bool }
export struct EventItem { id: int, channel: string, title: string, when: string, summary: string, state: string, dvr-uuid: string, logo: image, has-logo: bool, initials: string, description: string, channel-uuid: string, poster: image, has-poster: bool, subtitle: string, episode: string, facts: string, credits: string, rtl: bool }
export struct TlEvent { id: int, title: string, x: length, w: length, live: bool, rec: bool, rtl: bool }
export struct TlRow { uuid: string, name: string, initials: string, logo: image, has-logo: bool, events: [TlEvent] }
export struct ManageItem { uuid: string, number: int, name: string, enabled: bool }
export struct Tick { x: length, label: string }
export struct RecItem { uuid: string, title: string, channel: string, when: string, status: string, running: bool }

export global Theme {
    in property <bool> use-system: false;
    in property <bool> dark: true;
    in property <color> accent: #c6a0f6;
    in property <color> accent-dark: #cba6f7;
    in property <color> accent-light: #8839ef;
    in property <color> c-text: #cad3f5;
    in property <color> c-subtext: #a5adcb;
    in property <color> c-base: #24273a;
    in property <color> c-mantle: #1e2030;
    in property <color> c-surface0: #363a4f;
    in property <color> c-surface1: #494d64;
    in property <color> c-ok: #a6da95;
    in property <color> c-warn: #eed49f;
    in property <color> c-bad: #ed8796;
    out property <color> bg: use-system ? Palette.background : c-base;
    out property <color> bar: use-system ? Palette.alternate-background : c-mantle;
    out property <color> card: use-system ? Palette.control-background : c-surface0;
    out property <color> card-hi: use-system ? Palette.selection-background : c-surface1;
    out property <color> fg: use-system ? Palette.foreground : c-text;
    out property <color> fg-dim: use-system ? Palette.foreground.with-alpha(0.65) : c-subtext;
    out property <color> acc: use-system ? (Palette.color-scheme == ColorScheme.light ? accent-light : accent-dark) : accent;
    out property <color> on-acc: use-system ? (Palette.color-scheme == ColorScheme.light ? #ffffff : #1e1e2e) : c-base;
}


component TButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 40px; min-width: 72px; border-radius: 8px;
    background: !enabled ? Theme.card : (primary ? (ta.has-hover ? Theme.acc.brighter(0.15) : Theme.acc) : (ta.has-hover ? Theme.card-hi : Theme.card));
    Text { text: root.text; color: root.primary && root.enabled ? Theme.on-acc : Theme.fg; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    border-width: fs.has-focus ? 2px : 0px; border-color: Theme.acc;
    // The focus scope sits under the touch area: a click reaches the button at once (keyboard focus comes from Tab).
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; }
            reject
        }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component TField inherits Rectangle {
    in property <string> placeholder;
    in property <InputType> kind: InputType.text;
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited();
    in property <bool> autofocus: false;
    init => { if (root.autofocus) { input.focus(); } }
    min-height: 40px; border-radius: 8px; background: Theme.card;
    border-width: 2px; border-color: input.has-focus ? Theme.acc : transparent;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Rectangle {
            Text { visible: input.text == "" && input.preedit-text == ""; text: root.placeholder; color: Theme.fg-dim; vertical-alignment: center; overflow: elide; width: parent.width; }
            // Identifiers, URLs and passwords: no auto-capital, no auto-correct/suggestions
            input := TextInput {
                color: Theme.fg; input-type: root.kind; vertical-alignment: center; single-line: true;
                selection-background-color: Theme.acc.with-alpha(0.4); selection-foreground-color: Theme.fg;
                input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
            TouchArea { clicked => { input.focus(); } }
        }
    }
}

component InfoSection inherits VerticalLayout {
    in property <string> heading;
    in property <[InfoRow]> rows;
    in property <string> empty-text: "Nothing right now";
    spacing: 6px;
    Text { text: root.heading; color: Theme.acc; font-weight: 700; font-size: 14px; }
    if root.rows.length == 0: Text { text: root.empty-text; color: Theme.fg-dim; font-size: 13px; }
    for r in root.rows: Rectangle {
        background: Theme.card; border-radius: 8px;
        VerticalLayout {
            padding: 10px; spacing: 2px;
            Text { text: r.title; color: Theme.fg; font-weight: 600; overflow: elide; }
            Text { text: r.detail; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
        }
    }
}

component SignalMeter inherits Rectangle {
    in property <string> label;
    in property <float> value; // 0..100, negative = no bar
    in property <string> text;
    height: 22px;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.label; color: Theme.fg-dim; width: 34px; vertical-alignment: center; font-size: 12px; }
        Rectangle {
            background: Theme.card; border-radius: 4px;
            Rectangle {
                visible: root.value >= 0;
                x: 0; width: parent.width * clamp(root.value / 100, 0, 1); height: parent.height; border-radius: 4px;
                background: root.value >= 60 ? #a6da95 : (root.value >= 30 ? #eed49f : #ed8796);
            }
        }
        Text { text: root.text; color: Theme.fg; width: 64px; vertical-alignment: center; font-size: 12px; horizontal-alignment: right; }
    }
}


component Logo inherits Rectangle {
    in property <image> source;
    in property <bool> has-logo;
    in property <string> name; // initials shown when the channel has no logo
    width: 56px; height: 40px; border-radius: 6px;
    background: has-logo ? Theme.card-hi.with-alpha(0.35) : Theme.card-hi;
    if root.has-logo: Image { source: root.source; image-fit: contain; width: parent.width - 8px; height: parent.height - 8px; x: 4px; y: 4px; }
    if !root.has-logo: Text { text: root.name; color: Theme.fg-dim; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    // asked once after the chip becomes active, so its row can scroll to show it
    callback reveal(length, length);
    property <bool> fired: false;
    changed active => { root.fired = false; }
    Timer {
        interval: 200ms; running: root.active && !root.fired;
        triggered => { root.fired = true; root.reveal(root.absolute-position.x, root.width); }
    }
    height: 34px; border-radius: 17px;
    width: label.preferred-width + 28px;
    background: root.active ? Theme.acc : (ta.has-hover ? Theme.card-hi : Theme.card);
    border-width: cfs.has-focus ? 2px : 0px; border-color: Theme.fg;
    cfs := FocusScope { key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } reject } }
    label := Text { x: 14px; text: root.text; color: root.active ? Theme.on-acc : Theme.fg; vertical-alignment: center; font-size: 13px; font-weight: 600; height: parent.height; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> vertical;
    callback clicked();
    min-height: 44px; border-radius: 10px;
    background: root.active ? Theme.acc.with-alpha(0.22) : (ta.has-hover ? Theme.card : transparent);
    border-width: nfs.has-focus ? 2px : 0px; border-color: Theme.acc;
    nfs := FocusScope { key-pressed(e) => { if (e.text == Key.Return || e.text == " ") { root.clicked(); return accept; } reject } }
    Text {
        text: root.text; color: root.active ? Theme.acc : Theme.fg; font-weight: 700; font-size: root.vertical ? 14px : 11px; overflow: elide;
        horizontal-alignment: root.vertical ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
        vertical-alignment: center; x: root.vertical ? 16px : 0px; width: parent.width - (root.vertical ? 16px : 0px);
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component EventRow inherits Rectangle {
    in property <EventItem> ev;
    callback record();
    callback cancel();
    callback open();
    height: 92px;
    Rectangle {
        y: 4px; height: parent.height - 8px; background: Theme.card; border-radius: 8px; clip: true;
        border-width: efs.has-focus ? 2px : 0px; border-color: Theme.acc;
        efs := FocusScope { key-pressed(e) => { if (e.text == Key.Return) { root.open(); return accept; } reject } }
        TouchArea { clicked => { root.open(); } }
        HorizontalLayout {
            padding: 10px; spacing: 10px;
            if root.ev.channel != "": VerticalLayout { alignment: center; Logo { source: root.ev.logo; has-logo: root.ev.has-logo; name: root.ev.initials; } }
            VerticalLayout {
                horizontal-stretch: 1; spacing: 2px; alignment: center; min-width: 0px;
                Text { text: root.ev.channel != "" ? root.ev.when + "  ·  " + root.ev.channel : root.ev.when; color: Theme.fg-dim; font-size: 12px; overflow: elide; }
                Text { text: root.ev.episode != "" ? root.ev.title + "  ·  " + root.ev.episode : root.ev.title; color: Theme.fg; font-weight: 700; overflow: elide; horizontal-alignment: root.ev.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                Text { text: root.ev.subtitle != "" ? root.ev.subtitle : root.ev.summary; color: Theme.fg-dim; font-size: 12px; overflow: elide; horizontal-alignment: root.ev.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
            }
            VerticalLayout {
                alignment: center; spacing: 4px; width: 92px;
                if root.ev.state != "": Text { text: "● " + root.ev.state; color: Theme.c-bad; font-size: 12px; horizontal-alignment: right; }
                TButton {
                    text: root.ev.dvr-uuid != "" ? "Cancel" : "Record"; height: 34px;
                    clicked => { if root.ev.dvr-uuid != "" { root.cancel(); } else { root.record(); } }
                }
            }
        }
    }
}

component RecRow inherits Rectangle {
    in property <RecItem> rec;
    in property <int> kind; // 0 upcoming, 1 finished, 2 failed
    callback stop();
    callback cancel();
    callback remove();
    callback play();
    height: 84px;
    Rectangle {
        y: 4px; height: parent.height - 8px; background: Theme.card; border-radius: 8px; clip: true;
        HorizontalLayout {
            padding: 10px; spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 2px; alignment: center; min-width: 0px;
                Text { text: root.rec.title; color: Theme.fg; font-weight: 700; overflow: elide; }
                Text { text: root.rec.channel + "  ·  " + root.rec.when; color: Theme.fg-dim; font-size: 12px; overflow: elide; }
                Text { text: root.rec.status; color: root.rec.running ? Theme.c-bad : Theme.fg-dim; font-size: 12px; overflow: elide; }
            }
            VerticalLayout {
                alignment: center; spacing: 4px; width: 92px;
                if root.kind == 1 || root.rec.running: TButton { text: "▶ Play"; primary: true; height: 34px; clicked => { root.play(); } }
                if root.rec.running: TButton { text: "Stop"; height: 34px; clicked => { root.stop(); } }
                if !root.rec.running && root.kind == 0: TButton { text: "Cancel"; height: 34px; clicked => { root.cancel(); } }
                if !root.rec.running && root.kind != 0: TButton { text: "Delete"; height: 34px; clicked => { root.remove(); } }
            }
        }
    }
}

component TSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);
    min-height: 40px; border-radius: 8px; background: Theme.card;
    border-width: fs.has-focus ? 2px : 0px; border-color: Theme.acc;
    Text { x: 12px; width: parent.width - 40px; text: root.model[root.current-index]; color: Theme.fg; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 28px; text: "▾"; color: Theme.fg-dim; vertical-alignment: center; }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") { pop.show(); return accept; }
            if (e.text == Key.DownArrow && root.current-index < root.model.length - 1) { root.current-index += 1; root.selected(root.current-index); return accept; }
            if (e.text == Key.UpArrow && root.current-index > 0) { root.current-index -= 1; root.selected(root.current-index); return accept; }
            reject
        }
    }
    ta := TouchArea { clicked => { pop.show(); } }
    pop := PopupWindow {
        x: 0; y: root.height + 2px; width: root.width; height: min(root.model.length * 40px + 8px, 280px);
        close-policy: close-on-click-outside;
        Rectangle { background: Theme.bar; border-radius: 8px; border-width: 1px; border-color: Theme.card-hi; }
        Flickable {
            content-height: root.model.length * 40px + 8px;
            for item[i] in root.model: Rectangle {
                y: 4px + i * 40px; height: 40px; x: 4px; width: parent.width - 8px; border-radius: 6px;
                background: pa.has-hover ? Theme.card-hi : (i == root.current-index ? Theme.card : transparent);
                Text { x: 10px; text: item; color: i == root.current-index ? Theme.acc : Theme.fg; vertical-alignment: center; }
                pa := TouchArea { clicked => { root.current-index = i; root.selected(i); pop.close(); } }
            }
        }
    }
}

component AppearancePanel inherits VerticalLayout {
    in-out property <int> mode-index: 0;
    in-out property <int> flavor-index: 2;
    in-out property <int> accent-index: 3;
    callback apply(int, int, int);
    padding: 20px; spacing: 12px; alignment: start;
    Text { text: "Appearance"; color: Theme.fg; font-size: 22px; font-weight: 700; }
    Text { text: "Style"; color: Theme.fg-dim; }
    TSelect {
        model: ["Catppuccin", "AMOLED black", "System (native)"]; current-index <=> root.mode-index;
        selected(i) => { root.apply(root.flavor-index, root.accent-index, root.mode-index); }
    }
    // Flavor only means something for the Catppuccin style; AMOLED and System keep just the accent.
    if root.mode-index == 0 : Text { text: "Flavor"; color: Theme.fg-dim; }
    if root.mode-index == 0 : TSelect {
        model: ["Latte", "Frappé", "Macchiato", "Mocha"]; current-index <=> root.flavor-index;
        selected(i) => { root.apply(root.flavor-index, root.accent-index, root.mode-index); }
    }
    Text { text: "Accent"; color: Theme.fg-dim; }
    TSelect {
        model: ["Rosewater", "Flamingo", "Pink", "Mauve", "Red", "Maroon", "Peach", "Yellow", "Green", "Teal", "Sky", "Sapphire", "Blue", "Lavender"];
        current-index <=> root.accent-index;
        selected(i) => { root.apply(root.flavor-index, root.accent-index, root.mode-index); }
    }
}

component Header inherits Rectangle {
    in property <string> title;
    background: Theme.bar; height: 52px;
    Text { x: 16px; text: root.title; color: Theme.fg; font-size: 20px; font-weight: 700; vertical-alignment: center; height: parent.height; }
    @children
}

export component MainWindow inherits Window {
    title: "TVHme";
    icon: @image-url("../../../assets/icon-256.png");
    min-width: 360px; min-height: 560px; preferred-width: 1000px; preferred-height: 680px;
    background: Theme.bg;
    property <bool> dark: Theme.dark;
    property <bool> sys: Theme.use-system;
    init => { root.sync-scheme(); }
    changed dark => { root.sync-scheme(); }
    changed sys => { root.sync-scheme(); }
    function sync-scheme() {
        Palette.color-scheme = root.sys ? ColorScheme.unknown : (root.dark ? ColorScheme.dark : ColorScheme.light);
    }
    property <bool> wide: root.width >= 720px;

    // 0 = connect, 1 = main shell, 2 = appearance (before connecting)
    in-out property <int> screen: 0;
    // shell tab ids: 0 Live, 1 Guide, 2 Recordings, 3 Search, 4 Server (admin), 5 Settings
    in-out property <int> tab: 0;
    in property <bool> busy: false;
    in property <string> error;
    in property <bool> is-admin: false;
    in property <[NavItem]> nav;
    in-out property <string> toast;
    in property <[ChannelItem]> channels;
    in property <[TagItem]> tags;
    in-out property <int> guide-mode: 0;
    in property <[TlRow]> tl-rows;
    in property <[Tick]> tl-ticks;
    in property <length> tl-width: 0px;
    in property <length> tl-now-x: 0px;
    in property <bool> tl-busy: false;
    in-out property <bool> detail-open: false;
    in property <EventItem> detail;
    in-out property <string> channel-filter;
    in property <string> chan-uuid;
    in property <string> chan-name;
    in property <string> chan-initials;
    in property <image> chan-logo;
    in property <bool> chan-has-logo: false;
    in-out property <bool> picker-open: false;
    in property <[ChannelItem]> picker;
    in-out property <string> picker-filter;
    in property <[EventItem]> guide-events;
    in property <bool> guide-busy: false;
    in-out property <string> search-text;
    in-out property <bool> search-full: true;
    in property <[EventItem]> search-events;
    in property <string> search-note;
    in-out property <int> rec-kind: 0;
    in property <[RecItem]> recordings;
    in property <string> rec-note;
    in property <string> now-playing;
    in property <string> play-note;
    in property <bool> has-signal: false;
    in property <float> snr: -1;
    in property <float> ss: -1;
    in property <string> snr-text;
    in property <string> ss-text;
    in property <string> server-info;
    in property <[ManageItem]> manage-channels;
    in-out property <bool> manage-open: false;
    callback set-channel-enabled(string, bool);
    in property <string> me-text;
    in property <string> server-error;
    in property <bool> server-busy: false;
    in property <[InfoRow]> tuners;
    in property <[InfoRow]> streams;
    in property <[InfoRow]> clients;
    in property <length> extra-top: 0px;
    in-out property <string> host;
    in-out property <string> htsp-port: "9982";
    in-out property <bool> insecure: false;
    in-out property <string> user;
    in-out property <string> password;
    in-out property <string> auth-code;
    in-out property <int> t-mode: 0;
    in-out property <int> t-flavor: 2;
    in-out property <int> t-accent: 3;
    in-out property <int> player: 0;
    in-out property <bool> record-local: false;
    in-out property <string> record-dir;
    in-out property <string> audio-langs;
    in-out property <bool> audio-only-preferred: false;
    in-out property <bool> recording-local: false;
    in property <bool> can-integrate: false;
    in property <string> logo-problems;
    in property <bool> launcher-installed: false;
    callback toggle-launcher();
    callback record-dir-changed(string);
    callback audio-langs-changed(string);
    callback audio-only-preferred-changed(bool);
    callback toggle-local-record();
    in property <bool> can-record-local: false;
    callback record-local-changed(bool);
    in property <[string]> player-names;

    callback connect(string, string, string, string, bool, string);
    callback tab-changed(int);
    callback select-tag(string);
    callback open-channel(string);
    callback filter-channels(string);
    callback picker-filter-changed(string);
    callback guide-mode-changed(int);
    callback event-clicked(int);
    callback detail-record(int, string);
    callback detail-cancel(string, string);
    callback play(string);
    callback record-now(string, string);
    callback stop-playback();
    callback do-search(string, bool);
    callback record-event(int);
    callback cancel-recording(string);
    callback stop-recording(string);
    callback remove-recording(string);
    callback load-recordings(int);
    callback apply-theme(int, int, int);
    callback refresh-server();
    callback play-recording(string);
    callback sign-out();
    callback edit-connection();
    callback player-changed(int);

    Timer {
        interval: 4s; running: root.toast != "";
        triggered => { root.toast = ""; }
    }

    Rectangle {
        x: root.safe-area-insets.left; y: max(root.safe-area-insets.top, root.extra-top);
        width: parent.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: parent.height - max(root.safe-area-insets.top, root.extra-top) - root.safe-area-insets.bottom;

        if root.screen == 0: Flickable {
            content-height: max(self.height, form.preferred-height);
            form := VerticalLayout {
                alignment: center; padding: 24px; spacing: 10px;
                Text { text: "TVHme"; color: Theme.acc; font-size: 36px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "Connect to Tvheadend"; color: Theme.fg-dim; horizontal-alignment: center; }
                TField { placeholder: "Server address"; text <=> root.host; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure, root.auth-code); } }
                Text { text: "e.g. 10.0.0.5:9981 or https://tv.example.com"; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "HTSP port (signal)"; color: Theme.fg-dim; vertical-alignment: center; }
                    TField { placeholder: "9982"; text <=> root.htsp-port; kind: InputType.number; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure, root.auth-code); } }
                }
                TField { placeholder: "Username"; text <=> root.user; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure, root.auth-code); } }
                TField { placeholder: "Password"; kind: InputType.password; text <=> root.password; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure, root.auth-code); } }
                TField { placeholder: "Access code (optional, instead of password)"; kind: InputType.password; text <=> root.auth-code; accepted => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure, root.auth-code); } }
                CheckBox { text: "Allow self-signed certificate"; checked <=> root.insecure; }
                TButton {
                    text: root.busy ? "Connecting…" : "Connect"; primary: true; enabled: !root.busy;
                    clicked => { root.connect(root.host, root.htsp-port, root.user, root.password, root.insecure, root.auth-code); }
                }
                if root.error != "": Text { text: root.error; color: Theme.c-bad; wrap: word-wrap; horizontal-alignment: center; }
                TButton { text: "Appearance"; clicked => { root.screen = 2; } }
            }
        }

        if root.screen == 3: VerticalLayout {
            alignment: center; spacing: 12px;
            Text { text: "TVHme"; color: Theme.acc; font-size: 36px; font-weight: 800; horizontal-alignment: center; }
            Text { text: "Connecting…"; color: Theme.fg-dim; horizontal-alignment: center; }
        }

        if root.screen == 2: VerticalLayout {
            alignment: start;
            AppearancePanel {
                mode-index <=> root.t-mode; flavor-index <=> root.t-flavor; accent-index <=> root.t-accent;
                apply(f, a, m) => { root.apply-theme(f, a, m); }
            }
            HorizontalLayout { padding: 20px; padding-top: 4px; alignment: start; TButton { text: "Back"; primary: true; width: 120px; height: 44px; clicked => { root.screen = 0; } } }
        }

        if root.screen == 1: Rectangle {
            // navigation: rail on wide windows, bar at the bottom on narrow ones
            Rectangle {
                x: 0; y: root.wide ? 0px : parent.height - 60px;
                width: root.wide ? 200px : parent.width; height: root.wide ? parent.height : 60px;
                background: Theme.bar;
                if root.wide: VerticalLayout {
                    padding: 12px; spacing: 6px; alignment: start;
                    Text { text: "TVHme"; color: Theme.acc; font-size: 24px; font-weight: 800; }
                    Rectangle { height: 10px; }
                    for n in root.nav: NavButton {
                        text: n.label; vertical: true; active: root.tab == n.id;
                        clicked => { root.tab = n.id; root.tab-changed(n.id); }
                    }
                }
                if !root.wide: HorizontalLayout {
                    padding: 6px; spacing: 4px;
                    for n in root.nav: NavButton {
                        text: n.label; vertical: false; active: root.tab == n.id;
                        clicked => { root.tab = n.id; root.tab-changed(n.id); }
                    }
                }
            }
            Rectangle {
                x: root.wide ? 200px : 0px; y: 0;
                width: root.wide ? parent.width - 200px : parent.width;
                height: root.wide ? parent.height : parent.height - 60px;

                // ---- Live
                if root.tab == 0: VerticalLayout {
                    Header { title: "Live TV"; }
                    // mouse wheel scrolls the chips sideways; the chosen group is scrolled into view
                    TouchArea {
                        height: 50px;
                        scroll-event(e) => {
                            if (chips-flick.content-width <= chips-flick.width) { return reject; }
                            chips-flick.content-x = max(chips-flick.width - chips-flick.content-width, min(0px, chips-flick.content-x + e.delta-y + e.delta-x));
                            accept
                        }
                        chips-flick := Flickable {
                            content-width: chips.preferred-width + 24px;
                            chips := HorizontalLayout {
                                x: 12px; y: 8px; spacing: 8px; height: 34px;
                                for t in root.tags: Chip {
                                    text: t.name; active: t.selected; clicked => { root.select-tag(t.uuid); }
                                    reveal(ax, w) => { chips-flick.content-x = max(min(0px, chips-flick.width - chips-flick.content-width), min(0px, chips-flick.width / 2 - (ax - chips-flick.absolute-position.x - chips-flick.content-x) - w / 2)); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; padding-bottom: 6px; height: 48px;
                        TField { placeholder: "Search channels"; text <=> root.channel-filter; edited => { root.filter-channels(root.channel-filter); } }
                    }
                    ListView {
                        for ch in root.channels: Rectangle {
                            height: 104px;
                            Rectangle {
                                y: 4px; x: 8px; width: parent.width - 16px; height: parent.height - 8px;
                                background: Theme.card; border-radius: 10px; clip: true;
                                border-width: rfs.has-focus ? 2px : 0px; border-color: Theme.acc;
                                // keyboard / remote: Enter plays, Right opens the channel's guide
                                rfs := FocusScope {
                                    key-pressed(e) => {
                                        if (e.text == Key.Return) { root.play(ch.uuid); return accept; }
                                        if (e.text == Key.RightArrow) { root.open-channel(ch.uuid); return accept; }
                                        reject
                                    }
                                }
                                HorizontalLayout {
                                    padding: 10px; spacing: 12px;
                                    // the logo plays the channel
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 76px; height: 56px;
                                            Logo { width: 76px; height: 56px; source: ch.logo; has-logo: ch.has-logo; name: ch.initials; }
                                            Rectangle { background: logo-ta.has-hover ? #00000055 : transparent; border-radius: 6px; }
                                            Text { visible: logo-ta.has-hover; text: "▶"; color: white; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                                            logo-ta := TouchArea { clicked => { root.play(ch.uuid); } }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1; min-width: 0px; spacing: 1px; alignment: center;
                                        // the name opens the channel's own guide page
                                        Rectangle {
                                            height: 24px;
                                            Text { x: 0px; width: parent.width; horizontal-alignment: left; text: ch.number + "  " + ch.name; color: name-ta.has-hover ? Theme.acc : Theme.fg; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                            name-ta := TouchArea { clicked => { root.open-channel(ch.uuid); } }
                                        }
                                        // NOW and NEXT open that programme's card
                                        Rectangle {
                                            height: 26px;
                                            Text { x: 0px; width: parent.width; horizontal-alignment: left; text: ch.now-title != "" ? "NOW   " + ch.now-title : ""; color: now-ta.has-hover ? Theme.acc : Theme.fg; font-size: 13px; vertical-alignment: center; overflow: elide; }
                                            Rectangle { x: 0px; y: parent.height - 3px; height: 2px; width: parent.width * ch.now-progress; background: Theme.acc; visible: ch.now-title != ""; }
                                            now-ta := TouchArea { clicked => { if ch.now-id != 0 { root.event-clicked(ch.now-id); } else { root.open-channel(ch.uuid); } } }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            Text { x: 0px; width: parent.width; horizontal-alignment: left; text: ch.next-title != "" ? "NEXT  " + ch.next-time + "  " + ch.next-title : ""; color: next-ta.has-hover ? Theme.acc : Theme.fg-dim; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                            next-ta := TouchArea { clicked => { if ch.next-id != 0 { root.event-clicked(ch.next-id); } else { root.open-channel(ch.uuid); } } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.now-playing != "": Rectangle {
                        background: Theme.bar; height: 128px;
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: root.now-playing; color: Theme.fg; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                if root.can-record-local: TButton {
                                    text: root.recording-local ? "■ Saving" : "● Save"; width: 96px; height: 40px; primary: root.recording-local;
                                    clicked => { root.toggle-local-record(); }
                                }
                                TButton { text: "Stop"; width: 72px; height: 40px; clicked => { root.stop-playback(); } }
                            }
                            if root.has-signal && root.snr-text != "": SignalMeter { label: "SNR"; value: root.snr; text: root.snr-text; }
                            if root.has-signal && root.ss-text != "": SignalMeter { label: "SS"; value: root.ss; text: root.ss-text; }
                            if root.play-note != "": Text { text: root.play-note; color: Theme.c-warn; font-size: 12px; }
                            if !root.has-signal && root.play-note == "": Text { text: "Waiting for signal info…"; color: Theme.fg-dim; font-size: 12px; }
                        }
                    }
                }

                // ---- Guide: timeline / one channel / search
                if root.tab == 1: VerticalLayout {
                    Header { title: "Guide"; }
                    HorizontalLayout {
                        padding: 10px; padding-bottom: 4px; spacing: 8px; height: 52px; alignment: start;
                        Chip { text: "Timeline"; active: root.guide-mode == 0; clicked => { root.guide-mode = 0; root.guide-mode-changed(0); } }
                        Chip { text: "Channel"; active: root.guide-mode == 1; clicked => { root.guide-mode = 1; root.guide-mode-changed(1); } }
                        Chip { text: "Search"; active: root.guide-mode == 2; clicked => { root.guide-mode = 2; root.guide-mode-changed(2); } }
                    }

                    // --- timeline
                    if root.guide-mode == 0: VerticalLayout {
                        TouchArea {
                            height: 46px;
                            scroll-event(e) => {
                                if (gchips-flick.content-width <= gchips-flick.width) { return reject; }
                                gchips-flick.content-x = max(gchips-flick.width - gchips-flick.content-width, min(0px, gchips-flick.content-x + e.delta-y + e.delta-x));
                                accept
                            }
                            gchips-flick := Flickable {
                                content-width: gchips.preferred-width + 24px;
                                gchips := HorizontalLayout {
                                    x: 12px; y: 6px; spacing: 8px; height: 34px;
                                    Chip { text: "Now"; active: false; clicked => { tl.content-x = 0px; } }
                                    for t in root.tags: Chip {
                                        text: t.name; active: t.selected; clicked => { root.select-tag(t.uuid); }
                                        reveal(ax, w) => { gchips-flick.content-x = max(min(0px, gchips-flick.width - gchips-flick.content-width), min(0px, gchips-flick.width / 2 - (ax - gchips-flick.absolute-position.x - gchips-flick.content-x) - w / 2)); }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1; clip: true;
                            property <length> chan-w: root.wide ? 150px : 64px;
                            Rectangle {
                                x: parent.chan-w; y: 0px; height: 28px; width: parent.width - parent.chan-w; clip: true;
                                Rectangle {
                                    x: tl.content-x; y: 0px; height: 28px; width: root.tl-width;
                                    for tk in root.tl-ticks: Text { x: tk.x + 4px; text: tk.label; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; height: 28px; }
                                    for tk in root.tl-ticks: Rectangle { x: tk.x; width: 1px; height: 28px; background: Theme.card-hi; }
                                }
                            }
                            Rectangle {
                                x: 0px; y: 28px; width: parent.chan-w; height: parent.height - 28px; clip: true;
                                Rectangle {
                                    x: 0px; y: tl.content-y; height: root.tl-rows.length * 56px; width: parent.width;
                                    for r[i] in root.tl-rows: Rectangle {
                                        x: 0px; y: i * 56px; height: 56px; width: parent.width; background: Theme.bar;
                                        // the logo plays the channel, the name opens its own guide page
                                        Logo { x: root.wide ? 4px : 6px; y: root.wide ? 10px : 3px; source: r.logo; has-logo: r.has-logo; name: r.initials; width: root.wide ? 48px : 52px; height: root.wide ? 36px : 32px; }
                                        Rectangle { x: root.wide ? 4px : 6px; y: root.wide ? 10px : 3px; width: root.wide ? 48px : 52px; height: root.wide ? 36px : 32px; background: tl-logo-ta.has-hover ? #00000055 : transparent; border-radius: 6px; }
                                        Text { visible: tl-logo-ta.has-hover; x: root.wide ? 4px : 6px; y: root.wide ? 10px : 3px; width: root.wide ? 48px : 52px; height: root.wide ? 36px : 32px; text: "▶"; color: white; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                        tl-logo-ta := TouchArea { x: root.wide ? 4px : 6px; y: root.wide ? 10px : 3px; width: root.wide ? 48px : 52px; height: root.wide ? 36px : 32px; clicked => { root.play(r.uuid); } }
                                        Text { x: root.wide ? 58px : 2px; y: root.wide ? 0px : 36px; width: parent.width - (root.wide ? 62px : 4px); height: root.wide ? 56px : 18px; text: r.name; color: tl-name-ta.has-hover ? Theme.acc : Theme.fg; font-size: root.wide ? 12px : 10px; horizontal-alignment: root.wide ? TextHorizontalAlignment.left : TextHorizontalAlignment.center; vertical-alignment: center; overflow: elide; }
                                        tl-name-ta := TouchArea { x: root.wide ? 58px : 0px; y: root.wide ? 0px : 36px; width: parent.width - (root.wide ? 58px : 0px); height: root.wide ? 56px : 20px; clicked => { root.open-channel(r.uuid); } }
                                    }
                                }
                            }
                            tl := Flickable {
                                x: parent.chan-w; y: 28px; width: parent.width - parent.chan-w; height: parent.height - 28px;
                                content-width: root.tl-width; content-height: root.tl-rows.length * 56px;
                                for r[i] in root.tl-rows: Rectangle {
                                    x: 0px; y: i * 56px; height: 56px; width: root.tl-width;
                                    for ev in r.events: Rectangle {
                                        x: ev.x; y: 3px; width: ev.w; height: 50px; border-radius: 6px; clip: true;
                                        background: ev-ta.has-hover ? Theme.card-hi : (ev.live ? Theme.card-hi.with-alpha(0.7) : Theme.card);
                                        border-width: ev.rec ? 2px : (ev.live ? 1px : 0px); border-color: ev.rec ? Theme.c-bad : Theme.acc;
                                        if cfs2.has-focus: Rectangle { border-width: 2px; border-color: Theme.fg; border-radius: 6px; }
                                        cfs2 := FocusScope { key-pressed(e) => { if (e.text == Key.Return) { root.event-clicked(ev.id); return accept; } reject } }
                                        Text { x: 6px; width: parent.width - 10px; text: ev.title; color: Theme.fg; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-alignment: ev.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                                        ev-ta := TouchArea { clicked => { root.event-clicked(ev.id); } }
                                    }
                                }
                                Rectangle { x: root.tl-now-x; y: 0; width: 2px; height: max(tl.height, root.tl-rows.length * 56px); background: Theme.c-bad; }
                            }
                            if root.tl-rows.length == 0: Text { y: 80px; width: parent.width; text: root.tl-busy ? "Loading…" : "No channels"; color: Theme.fg-dim; horizontal-alignment: center; }
                        }
                    }

                    // --- one channel
                    if root.guide-mode == 1: VerticalLayout {
                        Rectangle {
                            height: 72px;
                            HorizontalLayout {
                                padding: 10px; spacing: 12px;
                                VerticalLayout { alignment: center; Logo { width: 64px; height: 48px; source: root.chan-logo; has-logo: root.chan-has-logo; name: root.chan-initials; } }
                                VerticalLayout {
                                    horizontal-stretch: 1; min-width: 0px; alignment: center;
                                    Text { text: root.chan-name; color: Theme.fg; font-size: 20px; font-weight: 700; overflow: elide; }
                                }
                                VerticalLayout { alignment: center; TButton { text: "Change"; width: 90px; height: 40px; clicked => { root.picker-filter = ""; root.picker-open = true; root.picker-filter-changed(""); } } }
                                VerticalLayout { alignment: center; TButton { text: "▶ Watch"; primary: true; width: 90px; height: 40px; clicked => { root.play(root.chan-uuid); } } }
                            }
                        }
                        if root.guide-events.length == 0: Text { text: root.guide-busy ? "Loading…" : "No guide data for this channel"; color: Theme.fg-dim; horizontal-alignment: center; }
                        ListView {
                            for ev in root.guide-events: EventRow {
                                ev: ev;
                                open => { root.event-clicked(ev.id); }
                                record => { root.record-event(ev.id); }
                                cancel => { root.cancel-recording(ev.dvr-uuid); }
                            }
                        }
                    }

                    // --- search
                    if root.guide-mode == 2: VerticalLayout {
                        VerticalLayout {
                            padding: 12px; spacing: 8px; height: 104px;
                            HorizontalLayout {
                                spacing: 8px; height: 42px;
                                TField { placeholder: "Search titles and descriptions"; text <=> root.search-text; accepted => { root.do-search(root.search-text, root.search-full); } }
                                TButton { text: "Search"; primary: true; width: 90px; clicked => { root.do-search(root.search-text, root.search-full); } }
                            }
                            CheckBox { text: "Also search descriptions"; checked <=> root.search-full; }
                        }
                        if root.search-note != "": Text { text: root.search-note; color: Theme.fg-dim; horizontal-alignment: center; }
                        ListView {
                            for ev in root.search-events: EventRow {
                                ev: ev;
                                open => { root.event-clicked(ev.id); }
                                record => { root.record-event(ev.id); }
                                cancel => { root.cancel-recording(ev.dvr-uuid); }
                            }
                        }
                    }
                }

                // ---- Recordings
                if root.tab == 2: VerticalLayout {
                    Header { title: "Recordings"; }
                    HorizontalLayout {
                        padding: 12px; spacing: 8px; height: 58px;
                        Chip { text: "Upcoming"; active: root.rec-kind == 0; clicked => { root.rec-kind = 0; root.load-recordings(0); } }
                        Chip { text: "Finished"; active: root.rec-kind == 1; clicked => { root.rec-kind = 1; root.load-recordings(1); } }
                        Chip { text: "Failed"; active: root.rec-kind == 2; clicked => { root.rec-kind = 2; root.load-recordings(2); } }
                    }
                    if root.rec-note != "": Text { text: root.rec-note; color: Theme.fg-dim; horizontal-alignment: center; wrap: word-wrap; }
                    ListView {
                        for r in root.recordings: RecRow {
                            rec: r; kind: root.rec-kind;
                            play => { root.play-recording(r.uuid); }
                            stop => { root.stop-recording(r.uuid); }
                            cancel => { root.cancel-recording(r.uuid); }
                            remove => { root.remove-recording(r.uuid); }
                        }
                    }
                }

                // ---- Server (admin)
                if root.tab == 4: VerticalLayout {
                    Header {
                        title: "Server";
                        TButton { x: parent.width - 98px; y: 8px; text: root.server-busy ? "…" : "Refresh"; enabled: !root.server-busy; width: 90px; height: 36px; clicked => { root.refresh-server(); } }
                    }
                    ScrollView {
                        VerticalLayout {
                            padding: 16px; spacing: 16px; alignment: start;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: root.me-text; color: Theme.fg; font-weight: 700; wrap: word-wrap; }
                                Text { text: root.server-info; color: Theme.fg-dim; wrap: word-wrap; font-size: 13px; }
                                if root.server-error != "": Text { text: root.server-error; color: Theme.c-bad; wrap: word-wrap; }
                            }
                            InfoSection { heading: "Tuners"; rows: root.tuners; empty-text: "No tuner information"; }
                            InfoSection { heading: "Active streams"; rows: root.streams; empty-text: "No active streams"; }
                            InfoSection { heading: "Connected clients"; rows: root.clients; empty-text: "No connected clients"; }
                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px; height: 40px;
                                    Text { text: "Channels (" + root.manage-channels.length + ")"; color: Theme.acc; font-weight: 700; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                                    TButton { width: 90px; text: root.manage-open ? "Hide" : "Manage"; clicked => { root.manage-open = !root.manage-open; } }
                                }
                                if root.manage-open: Text { text: "Switch a channel off to hide it for everyone. Sign in again to refresh Live and Guide."; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
                                if root.manage-open: ListView {
                                    height: min(root.manage-channels.length * 54px, 320px);
                                for c in root.manage-channels: Rectangle {
                                    background: Theme.card; border-radius: 8px; height: 48px;
                                    HorizontalLayout {
                                        padding: 6px; padding-left: 12px; spacing: 10px;
                                        Text { text: c.number > 0 ? c.number + "  " + c.name : c.name; color: c.enabled ? Theme.fg : Theme.fg-dim; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        TButton { width: 80px; text: c.enabled ? "On" : "Off"; primary: c.enabled; clicked => { root.set-channel-enabled(c.uuid, !c.enabled); } }
                                    }
                                }
                                }
                            }
                            Text { text: "More management (networks, recorder settings, users) is planned. The server decides what each account may change."; color: Theme.fg-dim; wrap: word-wrap; font-size: 12px; }
                        }
                    }
                }

                // ---- Settings
                if root.tab == 5: VerticalLayout {
                    Header { title: "Settings"; }
                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            VerticalLayout {
                                padding: 20px; padding-bottom: 0px; spacing: 8px;
                                Text { text: "Connection"; color: Theme.fg; font-size: 22px; font-weight: 700; }
                                Text { text: root.server-info; color: Theme.fg-dim; wrap: word-wrap; font-size: 13px; }
                                Text { text: root.me-text; color: Theme.fg-dim; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px; height: 42px;
                                    TButton { text: "Edit connection"; clicked => { root.edit-connection(); } }
                                    TButton { text: "Sign out"; clicked => { root.sign-out(); } }
                                }
                                Text { text: "Video player"; color: Theme.fg; font-size: 22px; font-weight: 700; }
                                TSelect { model: root.player-names; current-index <=> root.player; selected(i) => { root.player-changed(i); } }
                                if root.can-record-local: VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Recording on this computer"; color: Theme.fg; font-size: 18px; font-weight: 700; }
                                    CheckBox {
                                        text: "Start saving every channel I watch (mpv)"; checked <=> root.record-local;
                                        toggled => { root.record-local-changed(root.record-local); }
                                    }
                                    Text { text: "Folder (empty = Videos/TVHme)"; color: Theme.fg-dim; font-size: 13px; }
                                    TField { placeholder: "/home/you/Videos/TVHme"; text <=> root.record-dir; edited => { root.record-dir-changed(root.record-dir); } }
                                    Text { text: "Audio languages (e.g. ara,eng; empty = no preference)"; color: Theme.fg-dim; font-size: 13px; }
                                    TField { placeholder: "ara,eng"; text <=> root.audio-langs; edited => { root.audio-langs-changed(root.audio-langs); } }
                                    CheckBox {
                                        text: "Keep only these languages in saved files (needs ffmpeg)"; checked <=> root.audio-only-preferred;
                                        toggled => { root.audio-only-preferred-changed(root.audio-only-preferred); }
                                    }
                                }
                            }
                            if root.logo-problems != "": VerticalLayout {
                                padding: 20px; padding-top: 0px; spacing: 6px;
                                Text { text: "Channel logos that could not be loaded"; color: Theme.fg; font-size: 18px; font-weight: 700; }
                                Text { text: root.logo-problems; color: Theme.fg-dim; font-size: 12px; wrap: word-wrap; }
                            }
                            if root.can-integrate: VerticalLayout {
                                padding: 20px; padding-top: 0px; spacing: 8px;
                                Text { text: "App menu"; color: Theme.fg; font-size: 22px; font-weight: 700; }
                                Text { text: "Optional. Adds TVHme and its icon to this user's app menu so launchers and bars can show it. Nothing is installed unless you press the button."; color: Theme.fg-dim; font-size: 13px; wrap: word-wrap; }
                                TButton { text: root.launcher-installed ? "Remove from app menu" : "Add to app menu"; clicked => { root.toggle-launcher(); } }
                            }
                            AppearancePanel {
                                mode-index <=> root.t-mode; flavor-index <=> root.t-flavor; accent-index <=> root.t-accent;
                                apply(f, a, m) => { root.apply-theme(f, a, m); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.picker-open: FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        // (no focus grab here: the search field below takes focus itself, and Escape bubbles up to this scope)
        key-pressed(e) => { if (e.text == Key.Escape) { root.picker-open = false; return accept; } reject }
        Rectangle {
            background: #00000099;
            TouchArea { clicked => { root.picker-open = false; } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: root.wide ? 40px : 12px;
                width: min(parent.width - 16px, 520px); height: parent.height - (root.wide ? 80px : 24px);
                background: Theme.bg; border-radius: 14px; border-width: 1px; border-color: Theme.card-hi; clip: true;
                TouchArea { }
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    TField { height: 42px; autofocus: true; placeholder: "Search channels"; text <=> root.picker-filter; edited => { root.picker-filter-changed(root.picker-filter); } accepted => { if (root.picker.length > 0) { root.picker-open = false; root.open-channel(root.picker[0].uuid); } } }
                    ListView {
                        for ch in root.picker: Rectangle {
                            height: 56px; border-radius: 8px;
                            background: pk.has-hover ? Theme.card-hi : transparent;
                            HorizontalLayout {
                                padding: 4px; spacing: 10px;
                                VerticalLayout { alignment: center; Logo { width: 56px; height: 40px; source: ch.logo; has-logo: ch.has-logo; name: ch.initials; } }
                                Text { text: ch.number + "  " + ch.name; color: Theme.fg; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                            pk := TouchArea { clicked => { root.picker-open = false; root.open-channel(ch.uuid); } }
                        }
                    }
                }
            }
        }
    }

    if root.detail-open: FocusScope {
        x: 0px; y: 0px; width: root.width; height: root.height;
        init => { self.focus(); }
        key-pressed(e) => { if (e.text == Key.Escape) { root.detail-open = false; return accept; } reject }
        Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.detail-open = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: root.wide ? (parent.height - self.height) / 2 : parent.height - self.height - 8px;
            width: min(parent.width - 16px, 600px); height: min(parent.height - 24px, sheet.preferred-height + 32px);
            background: Theme.bg; border-radius: 14px; border-width: 1px; border-color: Theme.card-hi; clip: true;
            TouchArea { }
            ScrollView {
                sheet := VerticalLayout {
                    padding: 16px; spacing: 10px; alignment: start;
                    if root.detail.has-poster: Image { source: root.detail.poster; image-fit: contain; height: 180px; }
                    HorizontalLayout {
                        spacing: 10px;
                        Logo { source: root.detail.logo; has-logo: root.detail.has-logo; name: root.detail.initials; }
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center;
                            Text { text: root.detail.channel; color: Theme.fg-dim; font-size: 13px; overflow: elide; }
                            Text { text: root.detail.when; color: Theme.fg-dim; font-size: 13px; }
                        }
                    }
                    Text { text: root.detail.title; color: Theme.fg; font-size: 22px; font-weight: 700; wrap: word-wrap; horizontal-alignment: root.detail.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    if root.detail.episode != "" || root.detail.subtitle != "": Text {
                        text: root.detail.episode != "" && root.detail.subtitle != "" ? root.detail.episode + "  ·  " + root.detail.subtitle : root.detail.episode + root.detail.subtitle;
                        color: Theme.acc; font-size: 15px; font-weight: 600; wrap: word-wrap;
                        horizontal-alignment: root.detail.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    }
                    if root.detail.facts != "": Text { text: root.detail.facts; color: Theme.fg-dim; font-size: 13px; wrap: word-wrap; horizontal-alignment: root.detail.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    if root.detail.summary != "" && root.detail.summary != root.detail.subtitle: Text { text: root.detail.summary; color: Theme.fg; font-size: 15px; font-weight: 600; wrap: word-wrap; horizontal-alignment: root.detail.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    if root.detail.description != "" && root.detail.description != root.detail.summary: Text { text: root.detail.description; color: Theme.fg-dim; font-size: 14px; wrap: word-wrap; horizontal-alignment: root.detail.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    if root.detail.credits != "": Text { text: root.detail.credits; color: Theme.fg-dim; font-size: 13px; wrap: word-wrap; horizontal-alignment: root.detail.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    if root.detail.state != "": Text { text: "● " + root.detail.state; color: Theme.c-bad; }
                    HorizontalLayout {
                        spacing: 8px; height: 44px;
                        TButton { text: "▶ Watch channel"; primary: true; clicked => { root.detail-open = false; root.play(root.detail.channel-uuid); } }
                        TButton {
                            text: root.detail.dvr-uuid != "" ? "Cancel rec" : "Record";
                            clicked => { if root.detail.dvr-uuid != "" { root.detail-cancel(root.detail.dvr-uuid, root.detail.channel-uuid); } else { root.detail-record(root.detail.id, root.detail.channel-uuid); } }
                        }
                        TButton { text: "Close"; clicked => { root.detail-open = false; } }
                    }
                }
            }
        }
    }
    }

    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2; y: parent.height - self.height - (root.wide ? 24px : 84px);
        width: min(parent.width - 32px, 560px); height: 44px;
        background: Theme.card-hi; border-radius: 10px; border-width: 1px; border-color: Theme.acc;
        Text { text: root.toast; color: Theme.fg; horizontal-alignment: center; vertical-alignment: center; overflow: elide; width: parent.width - 20px; x: 10px; }
    }
}
